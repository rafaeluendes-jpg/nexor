# ============================================================
# JOLO FRANQUIAS — variaveis de ambiente
# Copie para .env e preencha. NUNCA comitar o .env preenchido.
# Marcadores:
#   [OPERADOR] = depende de credencial/conta externa do Rafael
#   [LOCAL]    = ja funciona no ambiente de desenvolvimento
# ============================================================

# ---------- geral ----------
NODE_ENV=development                        # [LOCAL] development | staging | production
API_PORT=3333                               # [LOCAL]
API_PUBLIC_URL=http://localhost:3333        # [LOCAL] em producao: https://api.DOMINIO.com.br
LANDING_PUBLIC_URL=http://localhost:3000    # [LOCAL] em producao: https://franquias.DOMINIO.com.br
CRM_PUBLIC_URL=http://localhost:3001        # [LOCAL] em producao: https://crm.DOMINIO.com.br
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001   # [LOCAL] lista separada por virgula

# ---------- banco ----------
DATABASE_URL=postgresql://jolo:jolo@localhost:5432/jolo_franquias?schema=public   # [LOCAL]
# Em producao (Supabase): postgresql://postgres:SENHA@db.PROJETO.supabase.co:5432/postgres

# ---------- containers de banco e fila (infra/docker) ----------
# Usados so pelo docker compose. A API le a DATABASE_URL acima.
POSTGRES_USER=jolo                          # [LOCAL]
POSTGRES_PASSWORD=jolo                      # [LOCAL] troque em qualquer maquina compartilhada
POSTGRES_DB=jolo_franquias                  # [LOCAL]
POSTGRES_PORT=5432                          # [LOCAL]
REDIS_PORT=6379                             # [LOCAL]

# ---------- redis / filas ----------
REDIS_URL=redis://localhost:6379            # [LOCAL]

# ---------- autenticacao ----------
AUTH_PROVIDER=local                         # [LOCAL] local (apenas dev) | supabase (producao)
JWT_SECRET=troque-este-valor-em-producao    # [LOCAL] usado somente pelo provider local
JWT_EXPIRES_IN=8h                           # [LOCAL]
SUPABASE_URL=                               # [OPERADOR] https://PROJETO.supabase.co
SUPABASE_ANON_KEY=                          # [OPERADOR] chave publica (pode ir ao navegador)
SUPABASE_SERVICE_ROLE_KEY=                  # [OPERADOR] SEGREDO — somente backend
SUPABASE_JWT_SECRET=                        # [OPERADOR] SEGREDO — validacao de token

# ---------- whatsapp cloud api (meta) ----------
META_APP_ID=                                # [OPERADOR]
META_APP_SECRET=                            # [OPERADOR] SEGREDO — assina o webhook
META_WHATSAPP_ACCESS_TOKEN=                 # [OPERADOR] SEGREDO — token do system user
META_WHATSAPP_PHONE_NUMBER_ID=              # [OPERADOR]
META_WHATSAPP_BUSINESS_ACCOUNT_ID=          # [OPERADOR] WABA ID
META_WEBHOOK_VERIFY_TOKEN=                  # [OPERADOR] string escolhida por voce, igual no painel da Meta
META_GRAPH_VERSION=v21.0                    # [LOCAL]

# ---------- numero exibido na landing ----------
NEXT_PUBLIC_WHATSAPP_NUMBER=                # [OPERADOR] DDI+DDD+numero, so digitos. Ex.: 5517999999999
NEXT_PUBLIC_WHATSAPP_MESSAGE="Ola! Vim pela pagina de franquias da Jolo e gostaria de falar com o dono."
NEXT_PUBLIC_API_URL=http://localhost:3333   # [LOCAL]
NEXT_PUBLIC_SITE_URL=http://localhost:3000  # [LOCAL]

# ---------- ia sdr ----------
AI_PROVIDER=disabled                        # [LOCAL] disabled | openai
AI_MODEL=gpt-4.1-mini                       # [OPERADOR] modelo do provider escolhido
OPENAI_API_KEY=                             # [OPERADOR] SEGREDO
AI_MAX_TOKENS=800                           # [LOCAL]

# ---------- storage / excel ----------
STORAGE_PROVIDER=local                      # [LOCAL] local | supabase
STORAGE_LOCAL_DIR=./var/storage             # [LOCAL]
SUPABASE_STORAGE_BUCKET=jolo-crm            # [OPERADOR]
EXCEL_EXPORT_PATH=./var/storage/exports     # [LOCAL]

# ---------- observabilidade ----------
LOG_LEVEL=info                              # [LOCAL]
SENTRY_DSN=                                 # [OPERADOR] opcional
